{
  "name": "lichtplan",
  "version": "1.0.0",
  "description": "Lichtplan - Lighting Plan Editor",
  "author": "example.com",
  "homepage": "https://wwwouter.github.io/lichtplan/",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache --max-warnings=0 .",
    "precommit": "npm run lint && npm run test",
    "prepare": "husky",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:web",
    "start": "vite preview --config web/vite.config.ts",
    "dev": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run web/src/webApi.test.ts",
    "test:integration": "vitest run src/renderer/src/__tests__/file-operations.test.tsx",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "@playwright/cli": "^0.1.9",
    "jspdf": "^4.1.0",
    "konva": "^10.2.0",
    "react-konva": "^19.2.2",
    "use-image": "^1.1.4",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.2.6",
    "vitest": "^4.0.18"
  }
}
